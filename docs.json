          "daily-work/email-review"
        ]
      },
      {
        "group": "AI & Estimate Review",
        "pages": [
          "ai-review/rivet",
          "ai-review/agent"
        ]
      },
      {
        "group": "Administration",
        "pages": [
          "admin/settings",
          "admin/integrations",
          "admin/security"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "best-practices"
        ]
